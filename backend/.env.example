# Server
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
CORS_ORIGIN=http://localhost:3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=smms_user
DB_PASSWORD=change_me
DB_NAME=smms
DB_CONNECTION_LIMIT=20

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Argon2
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Local file storage (replaces Cloudflare R2)
# Files are stored on disk under this directory, relative to the backend's
# working directory, using the exact same key layout R2 used
# (e.g. students/3/faces/<uuid>.jpg, media/photo/<uuid>.jpg).
LOCAL_STORAGE_DIR=uploads
# Must be reachable by both the browser and the Python AI service.
LOCAL_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:4000
LOCAL_STORAGE_SIGNING_SECRET=change_me_local_storage_signing_secret_min_32_chars
LOCAL_STORAGE_SIGNED_URL_EXPIRES_IN=3600

# Python AI Service
PYTHON_AI_BASE_URL=http://127.0.0.1:8000
PYTHON_AI_TIMEOUT_MS=120000
PYTHON_AI_API_KEY=change_me_internal_service_key

# Uploads
MAX_UPLOAD_SIZE_MB=500
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/x-matroska
ALLOWED_DOCUMENT_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/mp4,audio/wav,audio/x-m4a