# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Security
INTERNAL_API_KEY=change_me_internal_service_key
ALLOWED_ORIGINS=http://localhost:4000

# InsightFace
INSIGHTFACE_MODEL_NAME=buffalo_l
INSIGHTFACE_PROVIDERS=CPUExecutionProvider
INSIGHTFACE_DET_SIZE=800
FACE_MIN_DET_SCORE=0.45
FACE_MATCH_THRESHOLD=0.36

# FAISS
FAISS_INDEX_DIR=./storage/faiss_index
FAISS_INDEX_FILE=index.faiss
FAISS_EMBEDDING_DIM=512

# Speaker recognition (voice biometrics)
SPEAKER_MODEL_SOURCE=speechbrain/spkrec-ecapa-voxceleb
SPEAKER_MODEL_DIR=./storage/speaker_model
SPEAKER_EMBEDDING_DIM=192
SPEAKER_FAISS_INDEX_FILE=speaker_index.faiss
SPEAKER_MATCH_THRESHOLD=0.5
AUDIO_SEGMENT_SECONDS=4.0
AUDIO_MAX_SEGMENTS_SAMPLED=60
AUDIO_MIN_SEGMENT_SECONDS=1.5

# Storage / tmp
TMP_DIR=./storage/tmp
MAX_DOWNLOAD_SIZE_MB=600
DOWNLOAD_TIMEOUT_SECONDS=90

# Video processing
VIDEO_FRAME_INTERVAL_SECONDS=1.0
VIDEO_MAX_FRAMES_SAMPLED=60
VIDEO_PREVIEW_MAX_SECONDS=6
VIDEO_PREVIEW_MAX_HEIGHT=480
THUMBNAIL_MAX_HEIGHT=480

# OCR
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
FFMPEG_CMD=C:\Users\weblink\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-8.1.2-full_build\bin\ffmpeg.exe
FFPROBE_CMD=C:\Users\weblink\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-8.1.2-full_build\bin\ffprobe.exe